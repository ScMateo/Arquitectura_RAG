# =============================================================
# Variables de entorno — RAG CvLAC
# =============================================================
# Uso:
#   1. Copia este archivo como ".env":   cp .env.example .env
#   2. Cambia ÚNICAMENTE GOOGLE_API_KEY (el resto ya trae los defaults).
#
# NUNCA subas el .env al repositorio: ya está protegido en .gitignore.
# =============================================================

# --- Obligatorio: pídesela al equipo por un medio seguro ---
GOOGLE_API_KEY=TU_API_KEY_AQUI

# --- Servidor Qdrant (defaults de desarrollo local) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=cvlac_researchers

# --- Modelos (defaults del sistema, no modificar sin justificarlo) ---
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_DEVICE=cpu
GEMINI_MODEL=gemini-3.8-flash

# --- Ajuste fino del RAG (opcional, descomenta solo si lo necesitas) ---
# CHUNK_SIZE=1500
# MAX_HISTORY=10
# TOP_K_RETRIEVAL=20
# TOP_K_FINAL=15

# --- Optimización del LLM (opcional; valores por defecto) ---
# LLM_TIMEOUT_MS=60000
# LLM_TEMPERATURE_ANALYSIS=0.0
# LLM_TEMPERATURE_GENERATION=0.5
